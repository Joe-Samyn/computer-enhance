{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Debug - Generate (OSX)",
            "program": "${workspaceFolder}/build/haversine",
            "args": ["-generate", "100", "-o", "${workspaceFolder}/sample_data.json"],
            "env": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb-dap",
            "request": "launch", 
            "name": "Debug - Solve (OSX)",
            "program": "${workspaceFolder}/build/haversine",
            "args": ["-solve", "${workspaceFolder}/sample_data.json"],
            "env": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug - Solve (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/haversine",
            "args": ["-solve", "${workspaceFolder}/sample_data.json"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug - Generate (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/haversine",
            "args": ["-generate", "1000000", "-o", "${workspaceFolder}/sample_data.json"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}